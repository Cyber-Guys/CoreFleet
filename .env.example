# Copy to `.env` (gitignored) and fill in. docker compose reads it automatically.

# --- OpenAI (Jakarta report service) ---------------------------------------
OPENAI_API_KEY=sk-...
# Chat model for report text. gpt-4o-mini is a safe default.
OPENAI_MODEL_NAME=gpt-4o-mini
# Image model via the Responses image_generation tool (gpt-5-mini works broadly).
OPENAI_IMAGE_MODEL=gpt-5-mini

# --- Distributed deployment (leave unset for single-host) -------------------
# Point services at other machines by IP. Defaults use compose service names.
#
# Zenoh router location — set on the simulator AND server machines:
#   ZENOH_ROUTER=tcp/192.168.1.20:7447
#
# Webapp -> report service (nginx proxy upstream), if report is on another host:
#   REPORT_SERVICE_URL=http://192.168.1.30:9080
# Webapp -> Zenoh REST (nginx proxy upstream):
#   ZENOH_REST_URL=http://192.168.1.20:8000
#
# Server -> report service, if they are on different hosts:
#   INGEST_URL=http://192.168.1.30:9080/report/api/trips
#   ACTIVE_URL=http://192.168.1.30:9080/report/api/active
