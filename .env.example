# Copy to `.env` (gitignored) and fill in. docker compose reads it automatically.

# OpenAI key for the Jakarta report service.
OPENAI_API_KEY=sk-...

# Optional: the model the report service uses. The hackathon template uses gpt-5.5;
# gpt-4o-mini is a safe, widely-available default.
OPENAI_MODEL_NAME=gpt-4o-mini
