# Copy to `.env.local` to override dev defaults (Vite).

# The app calls the same-origin `/report-api` path (proxied to the report service).
# In `npm run dev`, the Vite dev server proxies /report-api to this URL:
VITE_DEV_REPORT_URL=http://localhost:9080

# Build-time override of the API base (default: /report-api, the nginx proxy path).
# Only set this if the browser should call the report service directly by URL.
# VITE_REPORT_API_URL=/report-api
