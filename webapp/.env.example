# Copy to `.env` to override defaults.

# Use bundled mock data (true) or hit the live Zenoh REST API (false).
VITE_USE_MOCK=true

# Zenoh router REST endpoint. In Docker, set to /fleet-api to use the nginx proxy.
VITE_FLEET_API_URL=http://localhost:8000

# Jakarta report service (live LLM driving reports). The Reports view falls back
# to a local preview if this is unreachable. In Docker, set to /report-api to use
# the nginx same-origin proxy.
VITE_REPORT_API_URL=http://localhost:9080
